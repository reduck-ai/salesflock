{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEO Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "URL"
  ],
  "properties": {
    "Answer": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "relation → GEOAnswers",
      "x-store": {
        "type": "relation",
        "target": "GEOAnswers",
        "dual": "Read"
      }
    },
    "Canonical": {
      "type": "string",
      "format": "uri",
      "x-store": {
        "type": "url"
      }
    },
    "Error": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Fetched at": {
      "type": "string",
      "description": "ISO 8601 date or date-time",
      "x-store": {
        "type": "date"
      }
    },
    "Final URL": {
      "type": "string",
      "format": "uri",
      "x-store": {
        "type": "url"
      }
    },
    "H2": {
      "type": "number",
      "x-store": {
        "type": "number"
      }
    },
    "H3": {
      "type": "number",
      "x-store": {
        "type": "number"
      }
    },
    "Published": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Schema types": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Search": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "relation → GEOSearches",
      "x-store": {
        "type": "relation",
        "target": "GEOSearches",
        "dual": "Results"
      }
    },
    "Status": {
      "type": "number",
      "x-store": {
        "type": "number"
      }
    },
    "Text length": {
      "type": "number",
      "x-store": {
        "type": "number"
      }
    },
    "URL": {
      "type": "string",
      "x-store": {
        "type": "title"
      }
    }
  }
}
