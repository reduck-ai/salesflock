{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEO Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "URL"
  ],
  "properties": {
    "Conversation": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Error": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Fetched at": {
      "type": "string",
      "description": "ISO 8601 date or date-time",
      "x-store": {
        "type": "date"
      }
    },
    "Final URL": {
      "type": "string",
      "format": "uri",
      "x-store": {
        "type": "url"
      }
    },
    "Status": {
      "type": "number",
      "x-store": {
        "type": "number"
      }
    },
    "Text length": {
      "type": "number",
      "x-store": {
        "type": "number"
      }
    },
    "URL": {
      "type": "string",
      "x-store": {
        "type": "title"
      }
    }
  }
}
