{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEO Prompts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Prompt"
  ],
  "properties": {
    "Answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "relation → GEOAnswers",
      "x-store": {
        "type": "relation",
        "target": "GEOAnswers",
        "dual": "Prompt"
      }
    },
    "Prompt": {
      "type": "string",
      "x-store": {
        "type": "title"
      }
    }
  }
}
