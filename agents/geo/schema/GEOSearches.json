{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEO Searches",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Name"
  ],
  "properties": {
    "Conversation": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Egress": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Engine": {
      "type": "string",
      "enum": [
        "brave"
      ],
      "x-store": {
        "type": "select"
      }
    },
    "Error": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Key": {
      "type": "string",
      "x-store": {
        "type": "rich_text"
      }
    },
    "Name": {
      "type": "string",
      "x-store": {
        "type": "title"
      }
    },
    "Searched at": {
      "type": "string",
      "description": "ISO 8601 date or date-time",
      "x-store": {
        "type": "date"
      }
    }
  }
}
